CAMELLIA_NEXUS_ADMIN_KEYRING_PATH=/etc/camellia-nexus/secrets/admin-keyring.json
CAMELLIA_NEXUS_METRICS_BIND=127.0.0.1:9093
CAMELLIA_NEXUS_OBJECT_STORAGE=database
CAMELLIA_NEXUS_OBJECT_HARD_LIMIT_BYTES=21474836480
CAMELLIA_NEXUS_OBJECT_MAX_BYTES=67108864
# Set filesystem only when CAMELLIA_NEXUS_OBJECT_STORAGE=filesystem.
# CAMELLIA_NEXUS_OBJECT_FILESYSTEM_ROOT=/var/lib/camellia-nexus/admin-objects
CAMELLIA_NEXUS_EVIDENCE_SCANNER=clamav
CAMELLIA_NEXUS_CLAMAV_ADDRESS=127.0.0.1:3310
CAMELLIA_NEXUS_CLAMAV_TIMEOUT_SECONDS=15
