[Unit]
Description=Camellia Nexus License Database Migration
Documentation=file:/usr/share/doc/camellia-nexus/systemd-deployment.md
After=network-online.target
Wants=network-online.target
Before=camellia-nexus-management-server.service camellia-nexus-management-admin-web.service camellia-nexus-management-admin-worker.service

[Service]
Type=oneshot
User=camellia-nexus-migrate
Group=camellia-nexus-migrate
UMask=0077
EnvironmentFile=/etc/camellia-nexus/management-common.env
EnvironmentFile=/etc/camellia-nexus/migrate.env
LoadCredential=database_password:/etc/camellia-nexus/secrets/database/migrate/password
Environment=DATABASE_PASSWORD_FILE=%d/database_password
ExecStart=/usr/local/bin/camellia-nexus-management-server migrate
RemainAfterExit=yes
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/etc/camellia-nexus/secrets -/var/lib/camellia-nexus
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
