[Unit]
Description=Camellia Nexus License Database Migration
Documentation=https://github.com/camellia-computing/nexus-management-server
After=network-online.target
Wants=network-online.target
Before=camellia-nexus-management-server.service camellia-nexus-management-admin-web.service camellia-nexus-management-admin-worker.service

[Service]
Type=oneshot
User=camellia-license
Group=camellia-license
UMask=0077
EnvironmentFile=/etc/camellia-nexus/management-common.env
ExecStart=/usr/local/bin/camellia-nexus-management-server migrate
RemainAfterExit=yes
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
