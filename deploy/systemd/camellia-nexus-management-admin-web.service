[Unit]
Description=Camellia Nexus Private Administration Web Service
Documentation=file:/usr/share/doc/camellia-nexus/systemd-deployment.md
After=network-online.target camellia-nexus-management-migrate.service
Wants=network-online.target
Requires=camellia-nexus-management-migrate.service

[Service]
Type=simple
User=camellia-nexus-admin-web
Group=camellia-nexus-admin-web
SupplementaryGroups=camellia-nexus-admin
UMask=0077
EnvironmentFile=/etc/camellia-nexus/management-common.env
EnvironmentFile=/etc/camellia-nexus/admin-web.env
ExecStart=/usr/local/bin/camellia-nexus-management-server admin-web
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/etc/camellia-nexus/secrets/public
ReadWritePaths=/var/lib/camellia-nexus/admin-objects
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
