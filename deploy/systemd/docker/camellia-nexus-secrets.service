[Unit]
Description=Stage Camellia Nexus production secrets
Documentation=file:/usr/share/doc/camellia-nexus/compose-production.md
Before=docker.service camellia-nexus-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/camellia-nexus/stage-production-secrets
RuntimeDirectory=camellia-nexus
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/camellia-nexus /var/lib/camellia-nexus
ReadWritePaths=/run/camellia-nexus
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
