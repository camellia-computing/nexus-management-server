CAMELLIA_NEXUS_ADMIN_BIND=127.0.0.1:8090
DATABASE_URL=postgres://nexus_admin_web:replace-with-url-safe-secret@127.0.0.1:5432/nexus
CAMELLIA_NEXUS_ADMIN_PUBLIC_ORIGIN=https://console.example.com
CAMELLIA_NEXUS_ADMIN_REQUEST_TIMEOUT_SECONDS=180
CAMELLIA_NEXUS_ADMIN_MAX_IN_FLIGHT=64
CAMELLIA_NEXUS_METRICS_BIND=127.0.0.1:9092
CAMELLIA_NEXUS_ADMIN_ASSET_DIR=/usr/share/camellia-nexus/admin-ui
CAMELLIA_NEXUS_ADMIN_KEYRING_PATH=/etc/camellia-nexus/secrets/admin/admin-keyring.json
CAMELLIA_NEXUS_ADMIN_FORWARDED_FOR_SECRET_PATH=/etc/camellia-nexus/secrets/admin/admin-proxy-secret
CAMELLIA_NEXUS_OBJECT_STORAGE=database
CAMELLIA_NEXUS_OBJECT_HARD_LIMIT_BYTES=21474836480
CAMELLIA_NEXUS_OBJECT_MAX_BYTES=67108864
# Set filesystem only when CAMELLIA_NEXUS_OBJECT_STORAGE=filesystem.
# CAMELLIA_NEXUS_OBJECT_FILESYSTEM_ROOT=/var/lib/camellia-nexus/admin-objects
CAMELLIA_NEXUS_EVIDENCE_SCANNER=clamav
CAMELLIA_NEXUS_CLAMAV_ADDRESS=127.0.0.1:3310
CAMELLIA_NEXUS_CLAMAV_TIMEOUT_SECONDS=15
