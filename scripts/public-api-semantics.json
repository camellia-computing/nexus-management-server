{
  "schemaVersion": 1,
  "oauthScope": "camellia.nexus.license",
  "deviceProofHeader": "x-camellia-device-proof",
  "deviceProofHeaderMaxBytes": 4096,
  "defaultJsonBodyMaxBytes": 65536,
  "workspaceConfigurationBodyMaxBytes": 8454144,
  "pageLimits": {
    "devices": 100,
    "teamMembers": 200,
    "workspace": 200
  },
  "mutationIdentity": {
    "field": "operationId",
    "format": "canonical-rfc4122-uuid-v4",
    "conflictError": "idempotency_conflict"
  },
  "optimisticConcurrency": {
    "field": "rowVersion",
    "conflictError": "workspace_version_conflict"
  },
  "teamLeaveRecovery": {
    "path": "GET /v1/team/operations/{operation_id}",
    "command": "leave_workspace",
    "bindings": ["operationId", "memberId", "rowVersion"],
    "session": "exact-original"
  },
  "proofScopes": [
    { "value": "activation:verify", "clientConstructs": true },
    { "value": "entitlement:refresh", "clientConstructs": true },
    { "value": "entitlement:status", "clientConstructs": true },
    { "value": "session:recover", "clientConstructs": false },
    { "value": "device:list", "clientConstructs": true },
    { "value": "device:remove:{device_id}", "clientConstructs": true },
    { "value": "billing:summary", "clientConstructs": true },
    { "value": "billing:payment:submit", "clientConstructs": true },
    { "value": "team:profile", "clientConstructs": true },
    { "value": "team:members", "clientConstructs": true },
    { "value": "team:member:update:{member_id}", "clientConstructs": true },
    { "value": "team:member:device-enrollment:create:{member_id}", "clientConstructs": true },
    { "value": "team:invitation:create", "clientConstructs": true },
    { "value": "team:invitation:accept", "clientConstructs": true },
    { "value": "team:device-enrollment:create", "clientConstructs": true },
    { "value": "team:device-enrollment:accept", "clientConstructs": true },
    { "value": "team:leave", "clientConstructs": true },
    { "value": "team:ownership:transfer", "clientConstructs": true },
    { "value": "workspace:shared:read", "clientConstructs": true },
    { "value": "workspace:shared:write", "clientConstructs": true },
    { "value": "workspace:shared:publish", "clientConstructs": true },
    { "value": "workspace:shared:purge", "clientConstructs": true },
    { "value": "workspace:sync:read", "clientConstructs": true },
    { "value": "workspace:sync:write", "clientConstructs": true },
    { "value": "workspace:alerts:read", "clientConstructs": true },
    { "value": "workspace:alerts:manage", "clientConstructs": true },
    { "value": "workspace:alerts:ack", "clientConstructs": true },
    { "value": "workspace:audit:read", "clientConstructs": true },
    { "value": "workspace:audit:export", "clientConstructs": true },
    { "value": "workspace:webhooks:list", "clientConstructs": true },
    { "value": "workspace:webhooks:create", "clientConstructs": true },
    { "value": "workspace:webhooks:deliveries", "clientConstructs": true },
    { "value": "workspace:webhooks:update:{endpoint_id}", "clientConstructs": true },
    { "value": "workspace:webhooks:rotate:{endpoint_id}", "clientConstructs": true },
    { "value": "workspace:webhooks:delete:{endpoint_id}", "clientConstructs": true }
  ],
  "routes": [
    "DELETE /v1/devices/{device_id}",
    "DELETE /v1/workspace/alerts/rules/{rule_id}",
    "DELETE /v1/workspace/configurations/{document_id}",
    "DELETE /v1/workspace/webhooks/{endpoint_id}",
    "GET /v1/billing/summary",
    "GET /v1/devices",
    "GET /v1/devices/{device_id}/removals/{operation_id}",
    "GET /v1/team/members",
    "GET /v1/team/operations/{operation_id}",
    "GET /v1/team/profile",
    "GET /v1/workspace/alerts/incidents",
    "GET /v1/workspace/alerts/rules",
    "GET /v1/workspace/audit/event-types",
    "GET /v1/workspace/audit/events",
    "GET /v1/workspace/audit/export",
    "GET /v1/workspace/configurations",
    "GET /v1/workspace/configurations/{document_id}",
    "GET /v1/workspace/sync/changes",
    "GET /v1/workspace/sync/checkpoint",
    "GET /v1/workspace/webhooks",
    "GET /v1/workspace/webhooks/deliveries",
    "PATCH /v1/team/members/{member_id}",
    "PATCH /v1/workspace/alerts/rules/{rule_id}",
    "PATCH /v1/workspace/webhooks/{endpoint_id}",
    "POST /v1/activations/confirm",
    "POST /v1/activations/verify",
    "POST /v1/billing/payment-claims",
    "POST /v1/devices/register",
    "POST /v1/entitlements/challenge",
    "POST /v1/entitlements/refresh",
    "POST /v1/entitlements/status",
    "POST /v1/session/logout",
    "POST /v1/session/recovery",
    "POST /v1/session/recovery/challenge",
    "POST /v1/team/device-enrollments",
    "POST /v1/team/device-enrollments/accept",
    "POST /v1/team/invitations",
    "POST /v1/team/invitations/accept",
    "POST /v1/team/leave",
    "POST /v1/team/members/{member_id}/device-enrollments",
    "POST /v1/team/ownership-transfer",
    "POST /v1/workspace/alerts/incidents/{incident_id}/acknowledge",
    "POST /v1/workspace/alerts/incidents/{incident_id}/resolve",
    "POST /v1/workspace/alerts/rules",
    "POST /v1/workspace/configurations",
    "POST /v1/workspace/configurations/{document_id}/publish",
    "POST /v1/workspace/configurations/{document_id}/purge",
    "POST /v1/workspace/configurations/{document_id}/restore",
    "POST /v1/workspace/configurations/{document_id}/revisions",
    "POST /v1/workspace/sync/checkpoint",
    "POST /v1/workspace/webhooks",
    "POST /v1/workspace/webhooks/{endpoint_id}/rotate-secret"
  ]
}
