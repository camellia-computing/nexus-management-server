# Reference for the non-secret production configuration. Copy it to the ignored .env file and
# replace every required value. Compose secret paths default to ./secrets below the deployment root.
# Never commit or paste the populated file. Passwords, private keys, keyrings, proxy secrets, tokens,
# and credentials belong in the secret system. Environment-specific hostnames and addresses belong
# in deployment configuration that is excluded from source control.

# Required production identity and compatibility policy. Empty values make Compose fail closed.
# CAMELLIA_NEXUS_LICENSE_IMAGE must be the canonical image@sha256 digest from the formal Release.
CAMELLIA_NEXUS_LICENSE_IMAGE=
# Reserved-domain shape example: https://license.example.com
CAMELLIA_NEXUS_LICENSE_ISSUER=
# Identifier of the active entitlement signing key, never the key itself.
CAMELLIA_NEXUS_LICENSE_KEY_ID=
CAMELLIA_NEXUS_CLIENT_MINIMUM_VERSION=
CAMELLIA_NEXUS_CLIENT_RECOMMENDED_VERSION=
# Absolute RFC3339/UTC date-time or Unix seconds; never a relative duration in production.
CAMELLIA_NEXUS_CLIENT_VERSION_ENFORCE_AFTER=
# Reserved-domain shape example: https://console.example.com
CAMELLIA_NEXUS_ADMIN_PUBLIC_ORIGIN=

# Stable protocol policy. Change only with the corresponding client/ingress contract.
CAMELLIA_NEXUS_LICENSE_AUDIENCE=camellia-nexus-desktop
CAMELLIA_NEXUS_OAUTH_CLIENT_ID=camellia-nexus-desktop
CAMELLIA_NEXUS_OAUTH_REDIRECT_URIS=camellia-nexus://auth/callback
CAMELLIA_NEXUS_CORS_ALLOWED_ORIGINS=camellia-nexus://localhost

# Runtime tuning shared by the Compose roles. These values are non-secret.
CAMELLIA_NEXUS_LOG_FORMAT=json
CAMELLIA_NEXUS_LOG_LEVEL=info
CAMELLIA_NEXUS_HTTP_LOG_LEVEL=info
CAMELLIA_NEXUS_HTTP_FAILURE_LOG_LEVEL=warn
CAMELLIA_NEXUS_DATABASE_MAX_CONNECTIONS=8
CAMELLIA_NEXUS_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
CAMELLIA_NEXUS_TIME_MAX_FORWARD_JUMP_SECONDS=86400
CAMELLIA_NEXUS_HTTP_REQUEST_TIMEOUT_SECONDS=15
CAMELLIA_NEXUS_HTTP_MAX_IN_FLIGHT=256
CAMELLIA_NEXUS_MAINTENANCE_INTERVAL_SECONDS=3600
CAMELLIA_NEXUS_CLEANUP_BATCH_SIZE=1000
CAMELLIA_NEXUS_ADMIN_REQUEST_TIMEOUT_SECONDS=180
CAMELLIA_NEXUS_ADMIN_MAX_IN_FLIGHT=64
CAMELLIA_NEXUS_OBJECT_HARD_LIMIT_BYTES=21474836480
CAMELLIA_NEXUS_OBJECT_MAX_BYTES=67108864

# Host policy. Compose keeps every published port on 127.0.0.1.
CAMELLIA_NEXUS_LICENSE_HOST_PORT=8088
CAMELLIA_NEXUS_LICENSE_METRICS_HOST_PORT=9091
CAMELLIA_NEXUS_ADMIN_HOST_PORT=8090
CAMELLIA_NEXUS_ADMIN_METRICS_HOST_PORT=9092

# Distinct database identities and host-side secret source files. Store only paths here.
CAMELLIA_NEXUS_DATABASE_NAME=nexus
CAMELLIA_NEXUS_DATABASE_BOOTSTRAP_ROLE=nexus_bootstrap
CAMELLIA_NEXUS_DATABASE_MIGRATE_ROLE=nexus_migrate
CAMELLIA_NEXUS_DATABASE_PUBLIC_ROLE=nexus_public
CAMELLIA_NEXUS_DATABASE_ADMIN_WEB_ROLE=nexus_admin_web
CAMELLIA_NEXUS_DATABASE_ADMIN_WORKER_ROLE=nexus_admin_worker
CAMELLIA_NEXUS_DATABASE_BOOTSTRAP_PASSWORD_FILE=./secrets/database-bootstrap-password
CAMELLIA_NEXUS_DATABASE_MIGRATE_PASSWORD_FILE=./secrets/database-migrate-password
CAMELLIA_NEXUS_DATABASE_PUBLIC_PASSWORD_FILE=./secrets/database-public-password
CAMELLIA_NEXUS_DATABASE_ADMIN_WEB_PASSWORD_FILE=./secrets/database-admin-web-password
CAMELLIA_NEXUS_DATABASE_ADMIN_WORKER_PASSWORD_FILE=./secrets/database-admin-worker-password

# Host-side non-database secret source files. Contents never belong in .env.
CAMELLIA_NEXUS_ENTITLEMENT_PRIVATE_KEY_FILE=./secrets/entitlement-es256-private.pem
CAMELLIA_NEXUS_WORKSPACE_KEYRING_FILE=./secrets/workspace-keyring.json
CAMELLIA_NEXUS_WEBHOOK_KEYRING_FILE=./secrets/webhook-keyring.json
CAMELLIA_NEXUS_ADMIN_KEYRING_FILE=./secrets/admin-keyring.json
CAMELLIA_NEXUS_ADMIN_PROXY_SECRET_FILE=./secrets/admin-proxy-secret
