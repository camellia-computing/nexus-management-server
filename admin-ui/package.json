{
  "name": "camellia-nexus-admin-ui",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write \"*.config.ts\" \"src/**/*.{svelte,ts,css}\" \"tests/**/*.{ts,json}\" \"static/**/*.js\"",
    "format:check": "prettier --check \"*.config.ts\" \"src/**/*.{svelte,ts,css}\" \"tests/**/*.{ts,json}\" \"static/**/*.js\"",
    "test:visual": "pnpm build && playwright test",
    "test:visual:built": "playwright test",
    "test:visual:stability": "playwright test --workers=1 --repeat-each=2 --grep \"all text sizes persist\"",
    "test:live": "svelte-kit sync && playwright test --config playwright.live.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.61.0"
  },
  "packageManager": "pnpm@11.28.7"
}
